# copy this to webui/.env and fill in the values

# required: analyze.py uses the Claude API to propose shorts candidates
ANTHROPIC_API_KEY=

# optional: only needed if YouTube starts blocking your own IP with
# "Sign in to confirm you're not a bot" (rare on a home/office network,
# common on cloud IPs). Absolute path to a cookies.txt file exported from a
# logged-in browser session.
YTDLP_COOKIES_FILE=

# optional: bold font used for the title banner, guest label, and burned-in
# captions. Defaults to a NanumGothicBold path that only exists on Linux.
# On Windows, point this at a Korean bold font already on the system, e.g.
# C:/Windows/Fonts/malgunbd.ttf (Malgun Gothic Bold) - no special escaping
# needed even though the path has a colon in it.
AUTOSHORTS_DISPLAY_FONT=

# optional: Claude model used for candidate analysis/caption correction.
# Defaults to claude-sonnet-5.
AUTOSHORTS_MODEL=
