# copy this to webui/.env and fill in the values

# required: analyze.py uses the Claude API to propose shorts candidates
ANTHROPIC_API_KEY=

# optional: only needed if YouTube starts blocking your own IP with
# "Sign in to confirm you're not a bot" (rare on a home/office network,
# common on cloud IPs). Absolute path to a cookies.txt file exported from a
# logged-in browser session.
YTDLP_COOKIES_FILE=

# optional: bold font used for the title banner, guest label, and burned-in
# captions. Defaults to a NanumGothicBold path that only exists on Linux.
# On Windows, point this at a Korean bold font already on the system, e.g.
# C:/Windows/Fonts/malgunbd.ttf (Malgun Gothic Bold) - no special escaping
# needed even though the path has a colon in it.
AUTOSHORTS_DISPLAY_FONT=

# optional: Claude model used for candidate analysis/caption correction.
# Defaults to claude-sonnet-5.
AUTOSHORTS_MODEL=

# optional: only needed for "완전 자동 모드" (the fully-automatic YouTube
# upload path, manual button or scheduler). By default these just sit next
# to this .env file as client_secret.json / youtube_token.json, so most
# setups don't need to set these at all - only override if you want them
# somewhere else.
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=

# optional: a playlist id on your own YouTube channel (e.g. a "라디올라"
# corner playlist) that every auto-uploaded short also gets added to, in
# addition to just sitting on the channel. Find it in the playlist's URL:
# https://www.youtube.com/playlist?list=THIS_PART_HERE . Leave blank to
# skip - uploads still happen, they just don't get added to any playlist.
RADIHOLA_PLAYLIST_ID=

# optional: disables the scheduler (config.py's PROGRAMS - the two
# registered radio programs whose playlists get watched automatically) -
# set to 0 to turn it off, e.g. for a machine that should only ever do
# manual/on-demand work. Defaults to on.
AUTOSHORTS_SCHEDULER_ENABLED=
